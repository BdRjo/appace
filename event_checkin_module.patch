+{% extends "base.html" %}
+{%- set ar = (current_lang == 'ar') -%}
+
+{% block title %}{{ 'فعالية جديدة' if ar else 'New Event' }}{% endblock %}
+
+{% block content %}
+<h1 style="font-size:1.3rem;font-weight:700;margin-bottom:16px">
+  <i class="bi bi-calendar-plus me-2" style="color:#0891b2"></i>{{ 'فعالية جديدة' if ar else 'New Event' }}
+</h1>
+
+<form method="POST" style="max-width:520px;background:#fff;border-radius:14px;padding:22px;box-shadow:0 2px 12px rgba(0,0,0,.06)">
+  <div class="mb-3">
+    <label class="form-label fw-semibold">{{ 'اسم الفعالية' if ar else 'Event Name' }}</label>
+    <input type="text" name="name" class="form-control" required placeholder="{{ 'مثال: اجتماع عام لكل الموظفين' if ar else 'e.g. All-staff meeting' }}">
+  </div>
+  <div class="mb-3">
+    <label class="form-label fw-semibold">{{ 'التاريخ' if ar else 'Date' }}</label>
+    <input type="date" name="event_date" class="form-control" required>
+  </div>
+  <div class="row g-2 mb-3">
+    <div class="col-6">
+      <label class="form-label fw-semibold">{{ 'من (الحضور بالوقت)' if ar else 'From (on-time)' }}</label>
+      <input type="time" name="window_start" class="form-control" required value="09:00">
+    </div>
+    <div class="col-6">
+      <label class="form-label fw-semibold">{{ 'إلى' if ar else 'To' }}</label>
+      <input type="time" name="window_end" class="form-control" required value="09:20">
+    </div>
+  </div>
+  <div class="mb-3">
+    <label class="form-label fw-semibold">{{ 'دقائق السماح للمتأخرين' if ar else 'Grace minutes for late arrivals' }}</label>
+    <input type="number" name="grace_minutes" class="form-control" value="5" min="0" max="60" style="max-width:120px">
+    <div class="form-text">{{ 'بعد هذه المدة، الرمز يصبح غير فعال ويُعتبر الموظف غائباً' if ar else 'After this, the code stops working and the person is marked absent' }}</div>
+  </div>
+  <button type="submit" class="btn" style="background:#0891b2;color:#fff;border:none;border-radius:8px;font-weight:700;padding:9px 24px">
+    <i class="bi bi-check2 me-1"></i>{{ 'إنشاء' if ar else 'Create' }}
+  </button>
+</form>
+{% endblock %}
diff --git a/templates/checkin/admin/list.html b/templates/checkin/admin/list.html
new file mode 100644
index 0000000..7b0a3b5
--- /dev/null
+++ b/templates/checkin/admin/list.html
@@ -0,0 +1,48 @@
+{% extends "base.html" %}
+{%- set ar = (current_lang == 'ar') -%}
+
+{% block title %}{{ 'تسجيل حضور الفعاليات' if ar else 'Event Check-in' }}{% endblock %}
+
+{% block content %}
+<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
+  <h1 style="font-size:1.3rem;font-weight:700;margin:0">
+    <i class="bi bi-calendar-check me-2" style="color:#0891b2"></i>{{ 'تسجيل حضور الفعاليات' if ar else 'Event Check-in' }}
+  </h1>
+  <a href="{{ url_for('checkin.admin_new') }}" class="btn btn-sm" style="background:#0891b2;color:#fff;border:none;border-radius:8px;font-weight:700;padding:8px 18px">
+    <i class="bi bi-plus-circle me-1"></i>{{ 'فعالية جديدة' if ar else 'New Event' }}
+  </a>
+</div>
+
+{% if events %}
+<div class="table-responsive">
+  <table class="table table-hover align-middle" style="background:#fff;border-radius:12px;overflow:hidden">
+    <thead style="background:#f0f9ff">
+      <tr>
+        <th>{{ 'الاسم' if ar else 'Name' }}</th>
+        <th>{{ 'التاريخ' if ar else 'Date' }}</th>
+        <th>{{ 'النافذة' if ar else 'Window' }}</th>
+        <th>{{ 'المدعوين' if ar else 'Attendees' }}</th>
+        <th></th>
+      </tr>
+    </thead>
+    <tbody>
+      {% for e in events %}
+      <tr>
+        <td style="font-weight:600">{{ e.name }}</td>
+        <td style="direction:ltr;text-align:end">{{ e.event_date }}</td>
+        <td style="direction:ltr;text-align:end">{{ e.window_start }} - {{ e.window_end }}</td>
+        <td>{{ e.attendees|length }}</td>
+        <td>
+          <a href="{{ url_for('checkin.admin_detail', event_id=e.id) }}" class="btn btn-sm" style="background:#ecfeff;color:#0e7490;border:none;border-radius:6px;font-weight:600">
+            {{ 'إدارة' if ar else 'Manage' }}
+          </a>
+        </td>
+      </tr>
+      {% endfor %}
+    </tbody>
+  </table>
+</div>
+{% else %}
+<div class="text-center text-muted" style="padding:40px">{{ 'لا توجد فعاليات بعد' if ar else 'No events yet' }}</div>
+{% endif %}
+{% endblock %}
diff --git a/templates/checkin/admin/report.html b/templates/checkin/admin/report.html
new file mode 100644
index 0000000..7bca236
--- /dev/null
+++ b/templates/checkin/admin/report.html
@@ -0,0 +1,67 @@
+{% extends "base.html" %}
+{%- set ar = (current_lang == 'ar') -%}
+
+{% block title %}{{ event.name }} — {{ 'تقرير' if ar else 'Report' }}{% endblock %}
+
+{% block extra_css %}
+<style>
+@media print {
+  .no-print { display: none !important; }
+  .main-content { margin: 0 !important; }
+  .content-area { padding: 0 !important; }
+}
+.status-pill { padding: 3px 10px; border-radius: 20px; font-size: .78rem; font-weight: 700; display: inline-block; }
+</style>
+{% endblock %}
+
+{% block content %}
+<div class="no-print d-flex justify-content-end gap-2 mb-3">
+  <button class="btn btn-sm" style="background:#0891b2;color:#fff;border:none;border-radius:8px;padding:7px 18px;font-weight:700" onclick="window.print()">
+    <i class="bi bi-printer me-1"></i>{{ 'طباعة' if ar else 'Print' }}
+  </button>
+  <a href="{{ url_for('checkin.admin_detail', event_id=event.id) }}" class="btn btn-sm" style="border:1.5px solid #d1d5db;border-radius:8px;padding:7px 18px;font-weight:600">
+    <i class="bi bi-x-lg me-1"></i>{{ 'إغلاق' if ar else 'Close' }}
+  </a>
+</div>
+
+<div style="text-align:center;margin-bottom:20px">
+  <h2 style="font-weight:800;color:#0e7490">{{ event.name }}</h2>
+  <div style="color:#6b7280;font-size:.9rem">
+    {{ event.event_date }} &middot; {{ 'من' if ar else 'From' }} {{ event.window_start }} {{ 'إلى' if ar else 'to' }} {{ event.window_end }}
+  </div>
+</div>
+
+<div class="row g-2 mb-4">
+  <div class="col-3 text-center"><div style="font-weight:900;font-size:1.4rem;color:#047857">{{ counts.on_time }}</div><div style="font-size:.78rem">{{ 'بالوقت' if ar else 'On Time' }}</div></div>
+  <div class="col-3 text-center"><div style="font-weight:900;font-size:1.4rem;color:#92400e">{{ counts.late }}</div><div style="font-size:.78rem">{{ 'متأخر' if ar else 'Late' }}</div></div>
+  <div class="col-3 text-center"><div style="font-weight:900;font-size:1.4rem;color:#b91c1c">{{ counts.absent }}</div><div style="font-size:.78rem">{{ 'غائب' if ar else 'Absent' }}</div></div>
+  <div class="col-3 text-center"><div style="font-weight:900;font-size:1.4rem;color:#4b5563">{{ resolved|length }}</div><div style="font-size:.78rem">{{ 'الإجمالي' if ar else 'Total' }}</div></div>
+</div>
+
+<table class="table table-bordered" style="font-size:.88rem">
+  <thead style="background:#f0f9ff">
+    <tr>
+      <th>{{ 'الاسم' if ar else 'Name' }}</th>
+      <th>{{ 'الحالة' if ar else 'Status' }}</th>
+      <th>{{ 'وقت الوصول' if ar else 'Time' }}</th>
+      <th>{{ 'سبب التأخير' if ar else 'Late Reason' }}</th>
+    </tr>
+  </thead>
+  <tbody>
+    {% for a, st in resolved %}
+    <tr>
+      <td style="font-weight:600">{{ a.name }}</td>
+      <td>
+        {% if st == 'on_time' %}<span class="status-pill" style="background:#ecfdf5;color:#047857">{{ 'حضر بالوقت' if ar else 'On time' }}</span>
+        {% elif st == 'late' %}<span class="status-pill" style="background:#fffbeb;color:#92400e">{{ 'متأخر' if ar else 'Late' }}</span>
+        {% elif st == 'absent' %}<span class="status-pill" style="background:#fef2f2;color:#b91c1c">{{ 'غائب' if ar else 'Absent' }}</span>
+        {% else %}<span class="status-pill" style="background:#f3f4f6;color:#4b5563">{{ 'بالانتظار' if ar else 'Pending' }}</span>
+        {% endif %}
+      </td>
+      <td style="direction:ltr;text-align:end">{{ a.checked_in_at.strftime('%H:%M') if a.checked_in_at else '-' }}</td>
+      <td>{{ a.late_reason or '-' }}</td>
+    </tr>
+    {% endfor %}
+  </tbody>
+</table>
+{% endblock %}
diff --git a/templates/checkin/checkin.html b/templates/checkin/checkin.html
new file mode 100644
index 0000000..1387bbb
--- /dev/null
+++ b/templates/checkin/checkin.html
@@ -0,0 +1,85 @@
+<!DOCTYPE html>
+{%- set ar = (current_lang == 'ar') -%}
+<html lang="{{ current_lang }}" dir="{{ 'rtl' if ar else 'ltr' }}">
+<head>
+<meta charset="UTF-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<title>{{ event.name }}</title>
+<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
+<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css">
+<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;900&display=swap" rel="stylesheet">
+<style>
+  body { font-family: {{ "'Tajawal', " if ar }}sans-serif; background: linear-gradient(160deg,#ecfeff,#f0fdfa 60%,#fff); min-height: 100vh;
+         display: flex; align-items: center; justify-content: center; padding: 16px; }
+  .card-box { max-width: 420px; width: 100%; background: #fff; border-radius: 20px; box-shadow: 0 10px 40px rgba(8,145,178,.14); padding: 32px 26px; text-align: center; }
+  .card-box h1 { font-size: 1.15rem; font-weight: 800; color: #0e7490; margin-bottom: 4px; }
+  .card-box .sub { font-size: .84rem; color: #6b7280; margin-bottom: 22px; }
+  .code-input { font-size: 1.6rem; font-weight: 900; letter-spacing: 6px; text-align: center; text-transform: uppercase;
+                border-radius: 12px; border: 2px solid #a5f3fc; padding: 12px; width: 100%; }
+  .code-input:focus { border-color: #0891b2; outline: none; box-shadow: 0 0 0 3px #a5f3fc55; }
+  .btn-submit { background: linear-gradient(135deg,#06b6d4,#0e7490); color: #fff; border: none; border-radius: 12px;
+                padding: 12px; font-weight: 800; font-size: 1rem; width: 100%; margin-top: 14px; }
+  .result-box { border-radius: 14px; padding: 20px; margin-top: 10px; }
+  .result-ok { background: #ecfdf5; border: 1.5px solid #6ee7b7; color: #047857; }
+  .result-late { background: #fffbeb; border: 1.5px solid #fcd34d; color: #92400e; }
+  .result-bad { background: #fef2f2; border: 1.5px solid #fca5a5; color: #b91c1c; }
+  .result-box .icn { font-size: 2.2rem; margin-bottom: 8px; display: block; }
+</style>
+</head>
+<body>
+<div class="card-box">
+  <i class="bi bi-calendar-check" style="font-size:2rem;color:#0891b2"></i>
+  <h1 class="mt-2">{{ event.name }}</h1>
+  <div class="sub">
+    {{ event.event_date }} &middot; {{ 'من' if ar else 'From' }} {{ event.window_start }} {{ 'إلى' if ar else 'to' }} {{ event.window_end }}
+  </div>
+
+  {% if result and result.ok %}
+    <div class="result-box {{ 'result-late' if result.late else 'result-ok' }}">
+      <i class="bi {{ 'bi-clock-history' if result.late else 'bi-check-circle-fill' }} icn"></i>
+      <div style="font-weight:800;font-size:1.05rem">
+        {% if result.late %}
+          {{ 'تم تسجيل حضورك متأخراً' if ar else 'Checked in — marked as late' }}
+        {% else %}
+          {{ 'تم تسجيل حضورك' if ar else 'Checked in successfully' }}
+        {% endif %}
+      </div>
+      <div style="font-size:.86rem;margin-top:4px">{{ result.name }}</div>
+    </div>
+
+  {% elif result and result.need_reason %}
+    <div class="result-box result-late">
+      <i class="bi bi-exclamation-triangle-fill icn"></i>
+      <div style="font-weight:700;font-size:.92rem">{{ result.message }}</div>
+    </div>
+    <form method="POST" class="mt-3 text-start">
+      <input type="hidden" name="code" value="{{ result.code }}">
+      <label style="font-size:.82rem;font-weight:700;color:#6b7280;display:block;margin-bottom:6px">
+        {{ 'سبب التأخير' if ar else 'Reason for lateness' }}
+      </label>
+      <textarea name="late_reason" required rows="2" class="form-control" style="border-radius:10px"
+                placeholder="{{ 'مثال: زحمة سير' if ar else 'e.g. traffic' }}"></textarea>
+      <button type="submit" class="btn-submit"><i class="bi bi-send me-1"></i>{{ 'إرسال' if ar else 'Submit' }}</button>
+    </form>
+
+  {% elif result %}
+    <div class="result-box result-bad">
+      <i class="bi bi-x-circle-fill icn"></i>
+      <div style="font-weight:700;font-size:.92rem">{{ result.message }}</div>
+    </div>
+    {% if not result.expired %}
+    <form method="POST" class="mt-3">
+      <input type="text" name="code" class="code-input" maxlength="10" placeholder="{{ 'الرمز' if ar else 'CODE' }}" autofocus required>
+      <button type="submit" class="btn-submit"><i class="bi bi-check2 me-1"></i>{{ 'تسجيل الحضور' if ar else 'Check In' }}</button>
+    </form>
+    {% endif %}
+
+  {% else %}
+    <form method="POST">
+      <input type="text" name="code" class="code-input" maxlength="10" placeholder="{{ 'الرمز' if ar else 'CODE' }}" autofocus required>
+      <button type="submit" class="btn-submit"><i class="bi bi-check2 me-1"></i>{{ 'تسجيل الحضور' if ar else 'Check In' }}</button>
+    </form>
+  {% endif %}
+</div>
+</body>
+</html>
diff --git a/utils/email_helper.py b/utils/email_helper.py
index 3a60701..d15b467 100644
--- a/utils/email_helper.py
+++ b/utils/email_helper.py
@@ -805,6 +805,38 @@ def send_reset_code(email: str, code: str, lang: str = 'ar') -> bool:
     return _send(email, '', subj, _html_wrapper(content, subj, lang), txt, sync=True)
 
 
+def send_event_checkin_code(email: str, name: str, code: str, event_name: str, event_date: str,
+                              window_start: str, window_end: str, checkin_url: str = '', lang: str = 'ar') -> bool:
+    """Send an attendee their one-time check-in code for a meeting/event."""
+    display_name = name or email
+    link_html = f'<p style="text-align:center;margin:12px 0 0"><a href="{checkin_url}" style="color:#0891b2;font-weight:700;text-decoration:none">{checkin_url}</a></p>' if checkin_url else ''
+
+    if lang == 'en':
+        content = f"""
+<p style="color:#4a5568;margin:0 0 20px">Hello {display_name}, you're invited to: <strong>{event_name}</strong></p>
+<p style="color:#4a5568;margin:0 0 16px">Date: <strong>{event_date}</strong> — Check-in window: <strong>{window_start} to {window_end}</strong></p>
+<div style="background:#ecfeff;border:2px dashed #0891b2;border-radius:12px;padding:20px;text-align:center;margin-bottom:20px">
+  <div style="font-size:32px;font-weight:900;letter-spacing:6px;color:#0e7490">{code}</div>
+</div>
+{link_html}
+<p style="color:#999;font-size:12px;margin-top:16px">This code is valid only during the check-in window above. Please arrive on time — a short grace period requires stating a reason for lateness.</p>"""
+        subj = f'Check-in code — {event_name}'
+        txt  = f'Your check-in code for {event_name} ({event_date}, {window_start}-{window_end}): {code}'
+    else:
+        content = f"""
