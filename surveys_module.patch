+++ b/templates/surveys/admin/new.html
@@ -0,0 +1,36 @@
+{% extends "base.html" %}
+{%- set ar = (current_lang == 'ar') -%}
+
+{% block title %}{{ 'استمارة جديدة' if ar else 'New Form' }}{% endblock %}
+
+{% block content %}
+<h1 style="font-size:1.3rem;font-weight:700;margin-bottom:16px">
+  <i class="bi bi-plus-circle me-2" style="color:#7c3aed"></i>{{ 'استمارة جديدة' if ar else 'New Form' }}
+</h1>
+
+<div style="max-width:640px">
+  <h6 class="fw-bold mb-2">{{ 'ابدأ من قالب جاهز' if ar else 'Start from a template' }}</h6>
+  <div class="row g-2 mb-4">
+    {% for key, tpl in templates.items() %}
+    <div class="col-12 col-md-6">
+      <form method="POST">
+        <input type="hidden" name="template" value="{{ key }}">
+        <button type="submit" class="w-100 text-start border rounded p-3" style="background:#fff;cursor:pointer;border-color:#e5e7eb !important">
+          <div style="font-weight:700;color:#7c3aed">{{ tpl.name_ar if ar else tpl.name_en }}</div>
+          <div style="font-size:.8rem;color:#6b7280;margin-top:4px">{{ tpl.desc_ar if ar else tpl.desc_en }}</div>
+          <div style="font-size:.74rem;color:#9ca3af;margin-top:6px">{{ tpl.questions|length }} {{ 'أسئلة' if ar else 'questions' }}</div>
+        </button>
+      </form>
+    </div>
+    {% endfor %}
+  </div>
+
+  <h6 class="fw-bold mb-2">{{ 'أو ابدأ من الصفر' if ar else 'Or start blank' }}</h6>
+  <form method="POST" class="d-flex gap-2">
+    <input type="text" name="name" class="form-control" placeholder="{{ 'اسم الاستمارة' if ar else 'Form name' }}" required>
+    <button type="submit" class="btn" style="background:#7c3aed;color:#fff;border:none;border-radius:8px;font-weight:700;padding:8px 20px;white-space:nowrap">
+      {{ 'إنشاء' if ar else 'Create' }}
+    </button>
+  </form>
+</div>
+{% endblock %}
diff --git a/templates/surveys/admin/responses.html b/templates/surveys/admin/responses.html
new file mode 100644
index 0000000..834ab02
--- /dev/null
+++ b/templates/surveys/admin/responses.html
@@ -0,0 +1,70 @@
+{% extends "base.html" %}
+{%- set ar = (current_lang == 'ar') -%}
+
+{% block title %}{{ survey.name }} — {{ 'الردود' if ar else 'Responses' }}{% endblock %}
+
+{% block content %}
+<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
+  <h1 style="font-size:1.3rem;font-weight:700;margin:0">
+    <i class="bi bi-bar-chart me-2" style="color:#7c3aed"></i>{{ survey.name }} — {{ 'الردود' if ar else 'Responses' }} ({{ response_rows|length }})
+  </h1>
+  <div class="d-flex gap-2">
+    <a href="{{ url_for('surveys.admin_responses_export', survey_id=survey.id) }}" class="btn btn-sm" style="border:1.5px solid #d1d5db;border-radius:8px;font-weight:600">
+      <i class="bi bi-download me-1"></i>{{ 'تصدير CSV' if ar else 'Export CSV' }}
+    </a>
+    <a href="{{ url_for('surveys.admin_builder', survey_id=survey.id) }}" class="btn btn-sm" style="border:1.5px solid #d1d5db;border-radius:8px;font-weight:600">
+      <i class="bi bi-arrow-right me-1"></i>{{ 'رجوع' if ar else 'Back' }}
+    </a>
+  </div>
+</div>
+
+{% if not response_rows %}
+<div class="text-center text-muted" style="padding:40px">{{ 'لا توجد ردود بعد' if ar else 'No responses yet' }}</div>
+{% else %}
+
+<!-- Per-question summary for choice/scale questions -->
+{% for q in survey.questions %}
+{% if q.id in summary %}
+<div style="background:#fff;border-radius:12px;padding:16px;margin-bottom:12px;box-shadow:0 2px 8px rgba(0,0,0,.05)">
+  <div style="font-weight:700;margin-bottom:10px">{{ q.question_text }}</div>
+  {% set total = summary[q.id].values() | sum %}
+  {% for opt, count in summary[q.id].items() %}
+  <div class="d-flex align-items-center gap-2 mb-1" style="font-size:.86rem">
+    <div style="width:140px;flex-shrink:0">{{ opt }}</div>
+    <div style="flex:1;background:#f5f3ff;border-radius:6px;height:18px;overflow:hidden">
+      <div style="background:#7c3aed;height:100%;width:{{ (count/total*100) if total else 0 }}%"></div>
+    </div>
+    <div style="width:40px;text-align:end;font-weight:600">{{ count }}</div>
+  </div>
+  {% endfor %}
+</div>
+{% endif %}
+{% endfor %}
+
+<!-- Raw responses table -->
+<div class="table-responsive mt-4">
+  <table class="table table-bordered" style="background:#fff;font-size:.86rem">
+    <thead style="background:#f5f3ff">
+      <tr>
+        <th>{{ 'المستجيب' if ar else 'Respondent' }}</th>
+        <th>{{ 'التاريخ' if ar else 'Date' }}</th>
+        {% for q in survey.questions %}
+        <th>{{ q.question_text }}</th>
+        {% endfor %}
+      </tr>
+    </thead>
+    <tbody>
+      {% for r, ans_map in response_rows %}
+      <tr>
+        <td>{{ r.respondent_name or '—' }}</td>
+        <td style="direction:ltr;text-align:end">{{ r.submitted_at.strftime('%Y-%m-%d %H:%M') if r.submitted_at else '' }}</td>
+        {% for q in survey.questions %}
+        <td>{{ ans_map.get(q.id, '') }}</td>
+        {% endfor %}
+      </tr>
+      {% endfor %}
+    </tbody>
+  </table>
+</div>
+{% endif %}
+{% endblock %}
diff --git a/templates/surveys/fill.html b/templates/surveys/fill.html
new file mode 100644
index 0000000..f0f6171
--- /dev/null
+++ b/templates/surveys/fill.html
@@ -0,0 +1,113 @@
+<!DOCTYPE html>
+{%- set ar = (current_lang == 'ar') -%}
+<html lang="{{ current_lang }}" dir="{{ 'rtl' if ar else 'ltr' }}">
+<head>
+<meta charset="UTF-8">
+<meta name="viewport" content="width=device-width,initial-scale=1">
+<title>{{ survey.name }}</title>
+<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
+<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css">
+<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;900&display=swap" rel="stylesheet">
+<style>
+  body { font-family: {{ "'Tajawal', " if ar }}sans-serif; background: linear-gradient(160deg,#f5f3ff,#faf5ff 60%,#fff); min-height: 100vh; padding: 24px 16px; }
+  .wrap { max-width: 640px; margin: 0 auto; }
+  .header-card { background: #fff; border-top: 10px solid #7c3aed; border-radius: 16px; padding: 26px; margin-bottom: 18px; box-shadow: 0 6px 24px rgba(124,58,237,.10); text-align: center; }
+  .header-card h1 { font-size: 1.3rem; font-weight: 800; color: #1f2937; margin: 8px 0 4px; }
+  .header-card .desc { font-size: .88rem; color: #6b7280; }
+  .q-card { background: #fff; border-radius: 14px; padding: 20px; margin-bottom: 14px; box-shadow: 0 2px 10px rgba(0,0,0,.05); }
+  .q-title { font-weight: 700; font-size: 1rem; margin-bottom: 12px; }
+  .q-title .req { color: #dc2626; }
+  .opt-label { display: flex; align-items: center; gap: 10px; padding: 8px 4px; cursor: pointer; }
+  .opt-label input { width: 18px; height: 18px; accent-color: #7c3aed; flex-shrink: 0; }
+  .scale-row { display: flex; align-items: center; justify-content: space-between; gap: 6px; }
+  .scale-item { display: flex; flex-direction: column; align-items: center; gap: 6px; font-size: .78rem; color: #6b7280; }
+  .scale-item input { width: 20px; height: 20px; accent-color: #7c3aed; }
+  .btn-submit { background: linear-gradient(135deg,#a78bfa,#7c3aed); color: #fff; border: none; border-radius: 12px;
+                padding: 13px; font-weight: 800; font-size: 1rem; width: 100%; margin-top: 6px; }
+  .error-box { background: #fef2f2; border: 1.5px solid #fca5a5; color: #b91c1c; border-radius: 12px; padding: 14px; margin-bottom: 14px; font-size: .86rem; font-weight: 600; }
+</style>
+</head>
+<body>
+<div class="wrap">
+  <div class="header-card">
+    {% if config and config.school_logo_b64 %}
+    {%- set _logo = config.school_logo_b64 -%}
+    {%- set _logo_src = _logo if _logo.startswith('data:') else ('data:image/png;base64,' ~ _logo) -%}
+    <img src="{{ _logo_src }}" alt="Logo" style="max-height:56px;max-width:160px;object-fit:contain">
+    {% else %}
+    <i class="bi bi-ui-checks-grid" style="font-size:1.8rem;color:#7c3aed"></i>
+    {% endif %}
+    <h1>{{ survey.name }}</h1>
+    {% if survey.description %}<div class="desc">{{ survey.description }}</div>{% endif %}
+  </div>
+
+  {% if error %}<div class="error-box"><i class="bi bi-x-circle-fill me-1"></i>{{ error }}</div>{% endif %}
+
+  <form method="POST" action="{{ url_for('surveys.public_submit', survey_id=survey.id) }}">
+    {% if survey.collect_name %}
+    <div class="q-card">
+      <div class="q-title">{{ 'الاسم' if ar else 'Name' }}</div>
+      <input type="text" name="respondent_name" class="form-control" placeholder="{{ 'اكتب اسمك' if ar else 'Your name' }}">
+    </div>
+    {% endif %}
+
+    {% for q in survey.questions %}
+    <div class="q-card">
+      <div class="q-title">{{ q.question_text }}{% if q.required %} <span class="req">*</span>{% endif %}</div>
+
+      {% if q.question_type == 'short_text' %}
+        <input type="text" name="q_{{ q.id }}" class="form-control" {{ 'required' if q.required }}>
+
+      {% elif q.question_type == 'paragraph' %}
+        <textarea name="q_{{ q.id }}" class="form-control" rows="3" {{ 'required' if q.required }}></textarea>
+
+      {% elif q.question_type == 'multiple_choice' %}
+        {% for opt in q.options_list %}
+        <label class="opt-label">
+          <input type="radio" name="q_{{ q.id }}" value="{{ opt }}" {{ 'required' if q.required }}>
+          {{ opt }}
+        </label>
+        {% endfor %}
+
+      {% elif q.question_type == 'checkboxes' %}
+        {% for opt in q.options_list %}
+        <label class="opt-label">
+          <input type="checkbox" name="q_{{ q.id }}" value="{{ opt }}">
+          {{ opt }}
+        </label>
+        {% endfor %}
+
+      {% elif q.question_type == 'dropdown' %}
+        <select name="q_{{ q.id }}" class="form-select" {{ 'required' if q.required }}>
+          <option value="" disabled selected>{{ 'اختر...' if ar else 'Choose...' }}</option>
+          {% for opt in q.options_list %}
+          <option value="{{ opt }}">{{ opt }}</option>
+          {% endfor %}
+        </select>
+
+      {% elif q.question_type == 'linear_scale' %}
+        <div class="scale-row">
+          {% if q.scale_min_label %}<span style="font-size:.78rem;color:#6b7280;max-width:80px">{{ q.scale_min_label }}</span>{% endif %}
+          {% for n in range(q.scale_min, q.scale_max + 1) %}
+          <div class="scale-item">
+            <span>{{ n }}</span>
+            <input type="radio" name="q_{{ q.id }}" value="{{ n }}" {{ 'required' if q.required }}>
+          </div>
+          {% endfor %}
+          {% if q.scale_max_label %}<span style="font-size:.78rem;color:#6b7280;max-width:80px;text-align:end">{{ q.scale_max_label }}</span>{% endif %}
+        </div>
+
+      {% elif q.question_type == 'date' %}
+        <input type="date" name="q_{{ q.id }}" class="form-control" {{ 'required' if q.required }}>
+
+      {% elif q.question_type == 'time' %}
+        <input type="time" name="q_{{ q.id }}" class="form-control" {{ 'required' if q.required }}>
+      {% endif %}
+    </div>
+    {% endfor %}
+
+    <button type="submit" class="btn-submit"><i class="bi bi-send me-1"></i>{{ 'إرسال' if ar else 'Submit' }}</button>
+  </form>
+</div>
+</body>
+</html>
