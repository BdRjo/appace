 <script>
+let _liveTimer = null, _liveCountdown = 10;
+function toggleLive(){
+  const on = document.getElementById('liveToggle').checked;
+  const statusEl = document.getElementById('liveStatus');
+  if(on){
+    statusEl.style.display = 'inline';
+    sessionStorage.setItem('checkinLiveOn', '1');
+    _liveCountdown = 10;
+    if(_liveTimer) clearInterval(_liveTimer);
+    _liveTimer = setInterval(() => {
+      _liveCountdown--;
+      document.getElementById('liveCountdown').textContent = _liveCountdown;
+      if(_liveCountdown <= 0) location.reload();
+    }, 1000);
+  } else {
+    statusEl.style.display = 'none';
+    sessionStorage.removeItem('checkinLiveOn');
+    if(_liveTimer) clearInterval(_liveTimer);
+  }
+}
+if(sessionStorage.getItem('checkinLiveOn') === '1'){
+  document.getElementById('liveToggle').checked = true;
+  toggleLive();
+}
+
+function copyCheckinUrl(){
+  const box = document.getElementById('checkinUrlBox');
+  box.select();
+  navigator.clipboard.writeText(box.value).catch(() => document.execCommand('copy'));
+}
