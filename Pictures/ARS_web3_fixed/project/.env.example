# ملف متغيرات البيئة — انسخه إلى .env وعدّله
# لا ترفع هذا الملف على GitHub (مضاف لـ .gitignore)

# للتطوير المحلي — السطر التالي اتركه فارغاً لاستخدام SQLite تلقائياً
DATABASE_URL=

# للنشر على Oracle / VPS مع PostgreSQL
# DATABASE_URL=postgresql://ars_user:كلمة_السر@localhost:5432/ars_venues

# مفتاح سري عشوائي — غيّره دائماً في الإنتاج
SECRET_KEY=غيّر-هذا-لمفتاح-عشوائي-طويل

# مسار قاعدة البيانات SQLite (إذا لم تستخدم PostgreSQL)
# ضع نفس المسار الذي يستخدمه التطبيق المكتبي
DB_PATH=ars_venues.db

# بيئة التشغيل: development أو production
FLASK_ENV=production

# مسار ملف إعدادات الصيانة (مشترك مع التطبيق المكتبي)
MAINTENANCE_CONFIG=maintenance_config.json
